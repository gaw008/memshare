# Secrets are read directly from the configured env_path; do not use environment injection.
# Generate separate random tokens for the two CLI identities. Never commit real credentials.
STATIC_TOKENS='{"replace-with-random-claude-code-token":"claude-code","replace-with-random-gemini-cli-token":"gemini-cli"}'
# Populate via: memhub --config memhub.toml set-password
# Missing password disables OAuth login (503); static tokens remain usable.
OAUTH_PASSWORD_HASH=''
